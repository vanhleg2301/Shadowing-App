# Copy to .env.local and fill in.
# Word lookup tries Claude first and falls back to free dictionaries when the key is missing or has no credits.
ANTHROPIC_API_KEY=
MODEL_ID=claude-opus-5-5

# Supabase (Google sign-in). Project Settings -> API: Project URL and the publishable (or anon) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/scripts only (never NEXT_PUBLIC_): Supabase secret / service_role key, used to store lesson transcripts.
SUPABASE_SERVICE_ROLE_KEY=

# Study reminders (web push). Generate a key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Any long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
